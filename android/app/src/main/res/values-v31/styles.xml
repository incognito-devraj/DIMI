<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) splash screen styles.
  On Android 12+, the OS controls the initial splash window via the
  SplashScreen API. We override the window background to match DIMI's
  cream color so there is no white flash before Flutter draws its first frame.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorAccent">@color/dimi_accent</item>
        <!-- Keep the window background cream so the OS splash window
             matches the Flutter splash screen background exactly. -->
        <item name="android:windowBackground">@color/launch_background</item>
        <!-- Android 12 SplashScreen: windowSplashScreenBackground sets
             the solid color behind the splash icon. -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <!-- Use the DIMI logo as the Android 12 splash screen icon.
             android:windowSplashScreenAnimatedIcon is the correct attribute.
             If the mipmap/ic_launcher is not the right asset, change this. -->
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorAccent">@color/dimi_accent</item>
        <!-- NormalTheme is shown while Flutter initializes.
             Must match AppColors.background (#FAF3EB) to avoid any flash
             between the OS splash and the first Flutter frame. -->
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
